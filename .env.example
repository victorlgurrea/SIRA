# Copiar a .env y ajustar
ZONA_NOMBRE=Mediterráneo Occidental - Costa Valenciana
LAT_REF=39.47
LON_REF=-0.38
CIUDAD_REF=Valencia
MAGNITUD_MIN=3.0
DIAS_ATRAS=30
# Percepción de sismos desde la localidad seleccionada (MMI ≥ II, USGS/QuakeFYI)
# Un evento es perceptible si distancia_km ≤ radio calculado para su magnitud.
# radio_km ≈ SISMO_PERCEPTIBLE_FACTOR × 10^(SISMO_PERCEPTIBLE_EXP_MAG × M + SISMO_PERCEPTIBLE_EXP_BASE)
# Ajuste más realista para visualización local: M4 ~80–120 km · M5 ~170–250 km · M6 ~320–450 km.
# SISMO_PERCEPTIBLE_FACTOR>1 amplía el radio; SISMO_PERCEPTIBLE_MAX_KM fija un tope (0 = sin tope).
SISMO_PERCEPTIBLE_MAG_MIN=2.5
SISMO_PERCEPTIBLE_FACTOR=1.0
SISMO_PERCEPTIBLE_EXP_MAG=0.34
SISMO_PERCEPTIBLE_EXP_BASE=0.30
SISMO_PERCEPTIBLE_PROF_KM=70
SISMO_PERCEPTIBLE_MAX_KM=450
# Alerta tsunami (USGS properties.tsunami=1) · radio desde epicentro en km
# radio_km ≈ TSUNAMI_FACTOR × 10^(TSUNAMI_EXP_MAG × (M − TSUNAMI_MAG_REF))
TSUNAMI_MAG_REF=6.5
TSUNAMI_MAG_MIN=6.5
TSUNAMI_FACTOR=100.0
TSUNAMI_EXP_MAG=0.55
TSUNAMI_PROF_KM=50
TSUNAMI_MIN_KM=80
TSUNAMI_MAX_KM=1200
# Feed NOAA tsunami.gov (amplitudes oficiales cuando hay evento emparejado)
# TSUNAMI_GOV_FEED_URL=https://www.tsunami.gov/php/esri.php?a=t&format=json
TSUNAMI_GOV_CACHE_SEC=300
# Avisos costeros AEMET (CO/RI) en mapa · círculos azules por zona litoral
COSTERO_RADIO_BASE_KM=75
COSTERO_RADIO_MIN_KM=45
COSTERO_RADIO_MAX_KM=160
COSTERO_OLEAJE_REF_M=3.0
COSTERO_FACTOR_AMARILLO=1.0
COSTERO_FACTOR_NARANJA=1.35
COSTERO_FACTOR_ROJO=1.7
UMBRAL_SCORE_ALERTA=55
ANOMALIA_SST_UMBRAL=0.8
MAPA_LAT_CENTRO=40.4168
MAPA_LON_CENTRO=-3.7038
MAPA_CIUDAD_CENTRO=Madrid
MAPA_LAT_MIN=32.0
MAPA_LAT_MAX=46.0
MAPA_LON_MIN=-12.0
MAPA_LON_MAX=8.0
MAPA_PROJECTION_SCALE=1.5
# Puntos marinos (SST y corrientes por costa)
MAR_MED_LAT=39.20
MAR_MED_LON=0.20
MAR_MED_PUNTO=Valencia
MAR_CANT_LAT=43.46
MAR_CANT_LON=-3.81
MAR_CANT_PUNTO=Santander
MAR_ATL_LAT=42.90
MAR_ATL_LON=-9.35
MAR_ATL_PUNTO=Costa atlántica — Galicia
AEMET_API_KEY=
AEMET_MUNICIPIO=46250
# Avisos CAP AEMET para push meteo (AT=calor, VI=viento, TO=tormenta, PR=lluvia, CO=costero)
AEMET_PUSH_MIN_LEVEL=amarillo
AEMET_ALERT_PHENOMENA=AT,BT,VI,TO,PR,CO,NE,VS,NI,DH,GA,RI,AL
API_KEY=
ALLOW_DATA_REFRESH=false
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
ENABLE_API_DOCS=false
RATE_LIMIT_SEC=60
CORS_ORIGINS=http://127.0.0.1:8050,http://localhost:8050
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8050
# Actualización automática del dashboard (minutos). Local: 5 está bien.
# En Render Free, subirlo (render.yaml usa 30) evita agotar las 750 h/mes
# de instancia del workspace si se deja una pestaña abierta (ver README).
DASHBOARD_REFRESH_MIN=5
# Solo informativo (label en UI). La frecuencia real del cron la marca
# .github/workflows/ingesta-hourly.yml (cada 3h en producción).
INGESTA_INTERVAL_MIN=60
# Secreto para POST /api/cron/ingesta (GitHub Actions). Genera uno aleatorio.
CRON_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sira.local
SCHEDULER_INTERVALO_MIN=30
OPEN_METEO_FORECAST_DAYS=7
# Cuadrícula SST Mediterráneo (Copernicus Marine — registro gratuito)
# https://data.marine.copernicus.eu/register
# En Render: añadir al grupo sira-secrets (servicio sira-api)
COPERNICUSMARINE_SERVICE_USERNAME=vlarranaga
COPERNICUSMARINE_SERVICE_PASSWORD=SIRA.valencia2026
# CMEMS_SST_DATASET_ID=cmems_mod_med_phy-tem_anfc_4.2km-2D_PT1H-m
# CMEMS_SST_VARIABLE=thetao
# Producto: https://data.marine.copernicus.eu/product/MEDSEA_ANALYSISFORECAST_PHY_006_013/description
# CMEMS_SST_LAT_MIN=30.00
# CMEMS_SST_LAT_MAX=46.50
# CMEMS_SST_LON_MIN=-6.00
# CMEMS_SST_LON_MAX=20.00
# CMEMS_SST_PASO_DEG=0.12
# CMEMS_SST_MAP_MAX_CELDAS=2600
# CMEMS_SST_ALLOW_OPEN_METEO_FALLBACK=0
# Horizonte del índice de riesgo meteo adverso en el dashboard (horas)
RIESGO_METEO_HORAS=48
# Índice compuesto impacto grave local (pesos 0–1, deben sumar ~1)
RIESGO_LOCAL_PESO_METEO=0.35
RIESGO_LOCAL_PESO_HIDRO=0.25
RIESGO_LOCAL_PESO_SISMO=0.20
RIESGO_LOCAL_PESO_INCENDIO=0.10
RIESGO_LOCAL_PESO_TERMICO=0.10
RIESGO_LOCAL_BONO_CONCURRENCIA=1.15
RIESGO_LOCAL_CONCURRENCIA_EJES=60
RIESGO_LOCAL_CONCURRENCIA_MIN=2
HTTP_TIMEOUT=30
# Incendios activos (NASA FIRMS — clave gratuita en firms.modaps.eosdis.nasa.gov/api/map_key)
FIRMS_MAP_KEY=
INCENDIO_DIAS=3
INCENDIO_CLUSTER_KM=4.0
INCENDIO_RADIO_MIN_KM=1.5
INCENDIO_RADIO_MAX_KM=35.0
INCENDIO_RADIO_LOCAL_KM=75.0
INCENDIO_MAP_MAX=50
COSTERO_MAP_MAX=12
MAP_CIRCLE_POINTS=40
# Embalses — embals.es (https://embals.es/docs/api) · apikey opcional
EMBALS_API_KEY=
# EMBALS_API_BASE=https://volcjmdnsxfuekvehwte.supabase.co/functions/v1
EMBALSE_CUENCAS=jucar,segura,ebro
EMBALSE_UMBRAL_VIGILANCIA=85
EMBALSE_UMBRAL_ALERTA=95
EMBALSE_UMBRAL_CRITICO=98
EMBALSE_RADIO_LOCAL_KM=120
EMBALSE_MAP_MAX=15
# Aforos — SAIH CHJ (https://saih.chj.es) · cuenca Júcar / MITECO
# CHJ_SAIH_BASE=https://saih.chj.es
AFORO_RADIO_LOCAL_KM=100
AFORO_MAP_MAX=20
AFORO_CAUDAL_VIGILANCIA_M3S=1.0
# SQLite persistente (push, alertas, historial municipal)
# Ruta relativa a la raíz del repo, o absoluta (p. ej. Render: DB_PATH=/data/sira.db)
DB_PATH=data/processed/sira.db
HISTORIAL_DIAS_DEFAULT=30
AFORO_DATOS_MAX_MIN=25
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Render (producción) ---
# No subas .env. Configura AEMET_API_KEY en el grupo sira-secrets del panel Render.
# Blueprint: render.yaml → New Blueprint → repo victorlgurrea/SIRA
# URLs: usa la URL exacta que Render asigne a sira-api (suele incluir sufijo),
#       y https://sira-dashboard.onrender.com para el dashboard.
